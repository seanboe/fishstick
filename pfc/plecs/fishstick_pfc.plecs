Plecs {
  Name          "fishstick_pfc"
  Version       "5.0"
  CircuitModel  "ContStateSpace"
  StartTime     "0.0"
  TimeSpan      "1.0"
  Timeout       ""
  Solver        "auto"
  MaxStep       "1e-3"
  InitStep      "-1"
  FixedStep     "1e-3"
  Refine        "1"
  ZCStepSize    "1e-9"
  RelTol        "1e-3"
  AbsTol        "-1"
  TurnOnThreshold "0"
  NonIdealSwitchResistance "1"
  SyncFixedStepTasks "2"
  UseSingleCommonBaseRate "2"
  LossVariableLimitExceededMsg "3"
  NegativeSwitchLossMsg "3"
  DivisionByZeroMsg "3"
  DatatypeOverflowMsg "3"
  DatatypeInheritanceConflictMsg "2"
  ContSampleTimeConflictMsg "2"
  StiffnessDetectionMsg "2"
  MaxConsecutiveZCs "1000"
  AlgebraicLoopWithStateMachineMsg "3"
  AssertionAction "1"
  FixedPointDatatypeOverride "1"
  InitializationCommands "% Grid\nV_in = 120*sqrt(2); % Grid voltage (V)\nF = "
"60.0; % Grid frequency (Hz)\n\n% Plant\nC = 200e-6; % Output capacitor (C)\nL"
" = 600e-6; % Choke inductance (H)\nRl = 0.001; % Choke resistance (ohms)\n\nf"
"s = 500e3; % Switching frequency (Hz)\n\n% Current Compensator\nRi.F = 100e3;"
" % Current control loop frequency (Hz)\nRi.Ts = 1/Ri.F; % sample time\nRi.Tp "
"= Ri.Ts/2.0; % Average PWM delay (s)\n\nRi.Ti = 2/Rl*Ri.Tp; \nRi.Tn = L/Rl;\n"
"\nRi.Kp = Ri.Tn/Ri.Ti;\nRi.Ki = 1/Ri.Ti;\n\n% Voltage Compensator\nRv.F = 100"
"0; % Voltage control loop frequency (Hz)\nRv.Ts = 1/Rv.F; % sample time\nRv.T"
"p = Rv.Ts/2*10; % equivalent delay (s)\n\nRv.Ti = 8/C*Rv.Tp*Rv.Tp;\nRv.Tn = 4"
"*Rv.Tp;\n\nRv.Kp = Rv.Tn/Rv.Ti;\nRv.Ki = 1/Rv.Ti;\n\n% Switching\nt_dead = 10"
"e-6;"
  InitialState  "1"
  SystemState   ""
  JacobianComputation "2"
  TaskingMode   "1"
  TaskConfigurations ""
  CodeGenParameterInlining "2"
