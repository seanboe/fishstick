  InitializationCommands "%% Electrical\nV_DC = 400;\t\t     %[V]\nPout_max = "
"150;    % Maximum output power\nPout_min = 50; \t % Minimum output power\nn_p"
"rim = 10;\nn_sndry = 1;\n\n%Primary Side\nL_r = 40e-6;\t\t\t  %[H]\nL_m = 160"
"e-6;\t\t  %[H]\nC_r = 2e-9;\t\t\t  %[F]\n\n%Secondary Side\nC_o = 100e-6;\t\t"
"  %[F]\nC_v_init = 0;\t\t  %[V]\nR_o = 2.5;\t\t\t  %[Ohm]\nESR = 15e-3;\t\t  "
"   %[Ohm]\nVF = 0.5;\n\nV_out_desired = 20; %[V]\n\n%% Controller\n\nR1 = 19."
"7e3;\nR2 = R1/3;\n\nV_ref = V_out_desired * R2 / (R1 + R2); % reference volta"
"ge\n\n%% Type 2 Compensator\nType2.wz1 = 2*pi*7e3; % frequency of type2 zero"
"\nType2.wp0 = 2e3; % DC gain of type 2 compensator\nType2.wp1 = 2*pi*12e3; % "
"frequency of type2 pole\n\n\n%% Device parameters\n\nRg_on = 2;\nRg_off = 2;"
"\ninit_junction_temp = 25.1;\n\n\n%% Sim parameters\nTavg = 5e-4;"
